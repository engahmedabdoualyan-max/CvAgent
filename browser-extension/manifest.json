{
  "manifest_version": 3,
  "name": "CvAgent — AI Career OS",
  "version": "3.0.0",
  "description": "Full AI Career OS: ON/OFF form auto-fill, JD scoring, tailored CV, cover letters, interview audio prep, voice-to-form, vault encryption, trackers & 30-feature suite. Powered by Groq Llama.",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "declarativeNetRequest"],
  "host_permissions": ["https://api.groq.com/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CvAgent — AI Career OS"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "trackers",
        "enabled": false,
        "path": "rules/trackers.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["injector.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
